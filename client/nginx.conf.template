server {
    listen 80;
    client_max_body_size 20m;

    root /usr/share/nginx/html;
    index index.html;

    # Versión visible: cabecera, /version y título de la pestaña
    add_header X-App-Version ${APP_VERSION} always;
    location = /version {
        default_type text/plain;
        return 200 "${APP_VERSION} ($hostname)
";
    }

    # SPA de React: cualquier ruta desconocida devuelve index.html
    location / {
        try_files $uri /index.html;
        sub_filter '</title>' ' ${APP_VERSION}</title>';
        sub_filter_once on;
        add_header Cache-Control "no-cache";
        add_header X-App-Version ${APP_VERSION} always;
    }

    # /api/... -> backend (se quita el prefijo /api)
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # /ai/... -> servicio de moderación (se quita el prefijo /ai)
    location /ai/ {
        proxy_pass ${AI_URL}/;
        proxy_set_header Host $host;
    }

    # Socket.io necesita upgrade a WebSocket
    location /socket.io/ {
        proxy_pass ${SOCKET_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
